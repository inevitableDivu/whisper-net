# ==============================================================================
# WhisperNet - Environment Configuration Template
# Copy to .env and adjust as needed: cp .env.example .env
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=production

# Server Network Binding
PORT=3000
HOST=0.0.0.0

# TLS / HTTPS Configuration (Required for shared network / LAN IP access without proxy)
# Set to 'false' if running behind a reverse proxy (e.g. Nginx, Caddy, Cloudflare Tunnel).
# Set to 'true' to terminate TLS directly with Bun using self-signed or Let's Encrypt certs.
HTTPS=false
TLS_CERT=certs/cert.pem
TLS_KEY=certs/key.pem

# SQLite Retention Database
DATABASE_PATH=data/whisper_net.sqlite

# Message Retention & Ephemeral Storage Policy
# Accidental reload retention window (in minutes)
CHAT_RETENTION_MINUTES=60
# Cleanup cron interval (in minutes)
CLEANUP_INTERVAL_MINUTES=5
# Maximum encrypted messages returned upon reconnection
MAX_HISTORY_PER_ROOM=100

# Security Boundaries & CORS
# In production, set to your domain (e.g. https://whisper.divyansh.co.in)
ALLOWED_ORIGINS=https://whisper.divyansh.co.in
MAX_PAYLOAD_BYTES=65536
MAX_PEERS_PER_ROOM=10

# Rate Limiting
HTTP_RATE_LIMIT=120
ROOM_CREATE_RATE_LIMIT=15
WS_MESSAGES_PER_WINDOW=60

# ==============================================================================
# SecureChat - Environment Configuration Template
# Copy to .env and adjust as needed: cp .env.example .env
# ==============================================================================

# Server Network Binding
PORT=3000
HOST=0.0.0.0

# TLS / HTTPS Configuration (Required for shared network / LAN IP access)
# Set to 'true' to serve with TLS so browsers enable WebCrypto (window.crypto.subtle)
HTTPS=false
TLS_CERT=certs/cert.pem
TLS_KEY=certs/key.pem

# SQLite Retention Database
DATABASE_PATH=data/secure_chat.sqlite

# Message Retention & Cleanup Policy
# Accidental reload retention window (in minutes)
CHAT_RETENTION_MINUTES=60
# Cleanup cron interval (in minutes)
CLEANUP_INTERVAL_MINUTES=5
# Maximum encrypted messages returned upon reconnection
MAX_HISTORY_PER_ROOM=100

# Security Boundaries
MAX_PAYLOAD_BYTES=65536
MAX_PEERS_PER_ROOM=10
ALLOWED_ORIGINS=*

# Rate Limiting
HTTP_RATE_LIMIT=100
ROOM_CREATE_RATE_LIMIT=15
WS_MESSAGES_PER_WINDOW=60

{
  "name": "whisper-net",
  "version": "1.0.0",
  "description": "Production-grade, zero-knowledge end-to-end encrypted (E2EE) ephemeral chat powered by Elysia, Bun, SQLite, and React 19.",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "author": "Divyansh <https://github.com/inevitableDivu>",
  "license": "MIT",
  "homepage": "https://github.com/inevitableDivu/whisper-net#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inevitableDivu/whisper-net.git"
  },
  "bugs": {
    "url": "https://github.com/inevitableDivu/whisper-net/issues"
  },
  "keywords": [
    "zero-knowledge",
    "e2ee",
    "end-to-end-encryption",
    "chat-application",
    "ephemeral-chat",
    "webcrypto",
    "aes-256-gcm",
    "pbkdf2",
    "elysia",
    "elysiajs",
    "bun",
    "react19",
    "vite",
    "sqlite",
    "websockets",
    "privacy-first",
    "shadcn",
    "zero-retention"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "certs": "bun run scripts/generate-certs.ts",
    "clean": "bun run scripts/clean.ts",
    "db:reset": "bun run scripts/db-reset.ts",
    "build": "vite build",
    "build:frontend": "vite build",
    "dev": "bun --watch run index.ts",
    "dev:https": "HTTPS=true bun --watch run index.ts",
    "dev:frontend": "vite",
    "start": "bun run index.ts",
    "start:https": "HTTPS=true bun run index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "demo": "bun run src/client-demo.ts"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@elysiajs/static": "^1.4.12",
    "@elysiajs/swagger": "^1.3.1",
    "@inevitable_divu/use-idb": "^1.5.2",
    "@types/bun": "^1.2.4",
    "elysia": "^1.4.32",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
